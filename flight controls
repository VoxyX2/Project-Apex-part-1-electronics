#include <Servo.h>

/*
  Twin-motor RC aircraft receiver interface

  This sketch expects ordinary PWM receiver outputs (about 1000-2000 us).
  For head tracking, configure the headset tracker/radio to output:
    camera pan  -> receiver channel connected to CAMERA_PAN_IN_PIN
    camera tilt -> receiver channel connected to CAMERA_TILT_IN_PIN

  Important: remove propellers for every bench test.  This is not a flight
  controller and does not provide stabilization, elevator, aileron, or rudder
  control.
*/

// -------------------- Receiver inputs --------------------
const byte THROTTLE_IN_PIN   = 2;
const byte STEERING_IN_PIN   = 3;   // Differential-thrust steering channel
const byte GEAR_IN_PIN       = 4;
const byte AUX1_IN_PIN       = 5;
const byte AUX2_IN_PIN       = 6;
const byte CAMERA_PAN_IN_PIN = 7;   // Head-tracker pan channel
const byte CAMERA_TILT_IN_PIN = A0; // Head-tracker tilt channel

// -------------------- ESC / servo outputs --------------------
const byte LEFT_MOTOR_PIN  = 8;
const byte RIGHT_MOTOR_PIN = 9;
const byte GEAR_SERVO_PIN  = 10;
const byte AUX1_SERVO_PIN  = 11;
const byte AUX2_SERVO_PIN  = 12;
const byte CAMERA_PAN_SERVO_PIN  = A2;
const byte CAMERA_TILT_SERVO_PIN = A3;

// -------------------- Radio / ESC settings --------------------
const int RX_MIN_US = 1000;
const int RX_MAX_US = 2000;
const int RX_VALID_MIN_US = 900;
const int RX_VALID_MAX_US = 2100;
const unsigned long RX_TIMEOUT_US = 25000UL;

const int ESC_STOP_US = 1000;
const int THROTTLE_DEADBAND_US = 1050; // Stick below this value always stops both motors
const int DIFFERENTIAL_MAX_US = 200;   // Maximum added/subtracted motor pulse
const unsigned long ESC_ARM_TIME_MS = 3000UL;

// Change these only after checking the mechanical limits of each servo.
const int GEAR_DEPLOYED_ANGLE = 180;
const int GEAR_RETRACTED_ANGLE = 0;
const int SERVO_CENTER_ANGLE = 90;

Servo leftMotor;
Servo rightMotor;
Servo gearServo;
Servo aux1Servo;
Servo aux2Servo;
Servo cameraPanServo;
Servo cameraTiltServo;

// Last good non-critical channel values. This prevents a brief missed pulse
// from snapping a servo to an arbitrary position.
int lastGearUs = RX_MAX_US; // Default to the selected deployed-gear failsafe state
int lastAux1Us = 1500;
int lastAux2Us = 1500;
int lastCameraPanUs = 1500;
int lastCameraTiltUs = 1500;

bool readReceiverPulse(byte pin, int &pulseUs) {
  unsigned long measuredUs = pulseIn(pin, HIGH, RX_TIMEOUT_US);

  if (measuredUs < RX_VALID_MIN_US || measuredUs > RX_VALID_MAX_US) {
    return false;
  }

  pulseUs = constrain((int)measuredUs, RX_MIN_US, RX_MAX_US);
  return true;
}

int pulseToAngle(int pulseUs) {
  return map(constrain(pulseUs, RX_MIN_US, RX_MAX_US),
             RX_MIN_US, RX_MAX_US, 0, 180);
}

void stopMotors() {
  leftMotor.writeMicroseconds(ESC_STOP_US);
  rightMotor.writeMicroseconds(ESC_STOP_US);
}

void setSafeServoPositions() {
  // Deploying the gear is the selected failsafe position. Reverse these
  // values if retracting is safer for your particular airframe.
  gearServo.write(GEAR_DEPLOYED_ANGLE);
  aux1Servo.write(SERVO_CENTER_ANGLE);
  aux2Servo.write(SERVO_CENTER_ANGLE);
  cameraPanServo.write(SERVO_CENTER_ANGLE);
  cameraTiltServo.write(SERVO_CENTER_ANGLE);
}

void setup() {
  pinMode(THROTTLE_IN_PIN, INPUT);
  pinMode(STEERING_IN_PIN, INPUT);
  pinMode(GEAR_IN_PIN, INPUT);
  pinMode(AUX1_IN_PIN, INPUT);
  pinMode(AUX2_IN_PIN, INPUT);
  pinMode(CAMERA_PAN_IN_PIN, INPUT);
  pinMode(CAMERA_TILT_IN_PIN, INPUT);

  leftMotor.attach(LEFT_MOTOR_PIN, RX_MIN_US, RX_MAX_US);
  rightMotor.attach(RIGHT_MOTOR_PIN, RX_MIN_US, RX_MAX_US);
  gearServo.attach(GEAR_SERVO_PIN);
  aux1Servo.attach(AUX1_SERVO_PIN);
  aux2Servo.attach(AUX2_SERVO_PIN);
  cameraPanServo.attach(CAMERA_PAN_SERVO_PIN);
  cameraTiltServo.attach(CAMERA_TILT_SERVO_PIN);

  // Send a low-throttle signal while the ESCs initialize.
  stopMotors();
  setSafeServoPositions();
  delay(ESC_ARM_TIME_MS);
}

